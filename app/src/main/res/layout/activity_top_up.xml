<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F8"
    android:fitsSystemWindows="true">

    <!-- HEADER -->
    <LinearLayout
        android:id="@+id/headerTopUp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_left_arrow"
            app:tint="#1E1E1E" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Top Up Saldo"
            android:textColor="#1E1E1E"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerTopUp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingVertical="24dp">

            <!-- KARTU SALDO SAAT INI -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#F28E35"
                app:cardCornerRadius="16dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Saldo"
                        android:textColor="#FFFFFF"
                        android:fontFamily="@font/inter"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Rp 1.000.000"
                        android:textColor="#FFFFFF"
                        android:textSize="24sp"
                        android:fontFamily="@font/inter_bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- METODE PEMBAYARAN -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Metode Pembayaran"
                android:textColor="#1E1E1E"
                android:textSize="14sp"
                android:fontFamily="@font/inter_semibold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <!-- Opsi BCA (Aktif) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnBca"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="#EAF6EC"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#00A859"
                    app:strokeWidth="2dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="20dp"
                            android:layout_marginEnd="8dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_logo_bca" />

                        <TextView
                            android:id="@+id/tvBca"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="BCA Transfer"
                            android:textColor="#00A859"
                            android:textSize="14sp"
                            android:fontFamily="@font/inter_bold" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Opsi QRIS (Tidak Aktif) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnQris"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#E5E7EB"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="20dp"
                            android:layout_marginEnd="8dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_logo_qris" />

                        <TextView
                            android:id="@+id/tvQris"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="QRIS"
                            android:textColor="#1E1E1E"
                            android:textSize="14sp"
                            android:fontFamily="@font/inter_bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- PILIH NOMINAL TOP UP -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Pilih Nominal Top Up"
                android:textColor="#1E1E1E"
                android:textSize="14sp"
                android:fontFamily="@font/inter_bold" />

            <!-- Baris 1: 20k & 40k -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnNominal20"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#E5E7EB"
                    app:strokeWidth="1dp">
                    <TextView
                        android:id="@+id/tvNominal20"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="Rp 20.000"
                        android:textColor="#1E1E1E"
                        android:textSize="14sp"
                        android:fontFamily="@font/inter_bold" />
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnNominal40"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#E5E7EB"
                    app:strokeWidth="1dp">
                    <TextView
                        android:id="@+id/tvNominal40"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="Rp 40.000"
                        android:textColor="#1E1E1E"
                        android:textSize="14sp"
                        android:fontFamily="@font/inter_bold" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Baris 2: 100k & 200k -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnNominal100"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#E5E7EB"
                    app:strokeWidth="1dp">
                    <TextView
                        android:id="@+id/tvNominal100"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="Rp 100.000"
                        android:textColor="#1E1E1E"
                        android:textSize="14sp"
                        android:fontFamily="@font/inter_bold" />
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnNominal200"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#E5E7EB"
                    app:strokeWidth="1dp">
                    <TextView
                        android:id="@+id/tvNominal200"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="Rp 200.000"
                        android:textColor="#1E1E1E"
                        android:textSize="14sp"
                        android:fontFamily="@font/inter_bold" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Baris 3: Nominal Lainnya -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnNominalLainnya"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                app:strokeColor="#E5E7EB"
                app:strokeWidth="1dp">
                <TextView
                    android:id="@+id/tvNominalLainnya"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="Nominal Lainnya"
                    android:textColor="#1E1E1E"
                    android:textSize="14sp"
                    android:fontFamily="@font/inter_bold" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:id="@+id/layoutInputManual"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="Masukkan Nominal"
                    android:textColor="#1E1E1E"
                    android:textSize="14sp"
                    android:fontFamily="@font/inter_bold" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#E5E7EB"
                    app:strokeWidth="1dp">

                    <EditText
                        android:id="@+id/etInputNominal"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@null"
                        android:hint="Contoh: 50000"
                        android:inputType="number"
                        android:paddingHorizontal="16dp"
                        android:textColor="#1E1E1E"
                        android:textColorHint="#9CA3AF"
                        android:textSize="14sp" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- TOMBOL TOP UP -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnProsesTopUp"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="32dp"
                android:text="Top Up Sekarang"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:fontFamily="@font/inter_bold"
                app:backgroundTint="#00A859"
                app:cornerRadius="12dp" />

            <!-- DISCLAIMER -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:text="*Saldo yang sudah dibeli tidak dapat dikembalikan"
                android:textColor="#9CA3AF"
                android:fontFamily="@font/inter"
                android:textSize="12sp" />

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>