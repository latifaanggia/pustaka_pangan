<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet_white"
    android:paddingBottom="24dp">

    <!-- Handle Bar -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_handle_bar" />

    <!-- Header: Judul + Tombol Close -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="24dp"
        android:paddingTop="20dp"
        android:paddingBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Konfirmasi Pembelian"
            android:textSize="18sp"
            android:textColor="#1E1E1E"
            android:fontFamily="@font/inter_bold" />

        <ImageView
            android:id="@+id/btnCloseSheet"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignParentEnd="true"
            android:src="@drawable/ic_close"
            app:tint="#6B7280" />
    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E5E7EB" />

    <!-- Info Majalah -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="20dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="64dp"
            android:layout_height="88dp"
            app:cardCornerRadius="6dp"
            app:cardElevation="2dp">

            <ImageView
                android:id="@+id/imgCoverSheet"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/img_2026_vol_07" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvJudulSheet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="FRI VOL XXI/07 2026"
                android:textSize="16sp"
                android:textColor="#1E1E1E"
                android:fontFamily="@font/inter_bold" />

            <TextView
                android:id="@+id/tvHargaSheet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Rp20.000"
                android:textSize="16sp"
                android:textColor="#00A859"
                android:fontFamily="@font/inter_semibold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Rincian Saldo -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#F4F6F8"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="24dp"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Saldo Saat Ini"
                android:textSize="14sp"
                android:textColor="#6B7280"
                android:fontFamily="@font/inter" />

            <TextView
                android:id="@+id/tvSaldoSaatIni"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rp1.000.000"
                android:textSize="14sp"
                android:textColor="#1E1E1E"
                android:fontFamily="@font/inter_semibold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Harga Majalah"
                android:textSize="14sp"
                android:textColor="#6B7280"
                android:fontFamily="@font/inter" />

            <TextView
                android:id="@+id/tvHargaPotong"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="- Rp20.000"
                android:textSize="14sp"
                android:textColor="#E74C3C"
                android:fontFamily="@font/inter_semibold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@drawable/bg_dashed_line"
            android:layout_marginVertical="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Sisa Saldo"
                android:textSize="14sp"
                android:textColor="#1E1E1E"
                android:fontFamily="@font/inter_semibold" />

            <TextView
                android:id="@+id/tvSisaSaldo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rp980.000"
                android:textSize="14sp"
                android:textColor="#1E1E1E"
                android:fontFamily="@font/inter_bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Tombol Beli -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnKonfirmasiBeli"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="20dp"
        android:text="Beli Sekarang"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:fontFamily="@font/inter_semibold"
        android:textAllCaps="false"
        app:backgroundTint="#00AA5B"
        app:cornerRadius="8dp" />

</LinearLayout>