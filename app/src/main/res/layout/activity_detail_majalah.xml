<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F8"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="40dp">

        <!-- 1. HEADER -->
        <LinearLayout
            android:id="@+id/headerLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#FFFFFF"
            android:elevation="4dp"
            android:paddingHorizontal="24dp"
            android:paddingTop="24dp"
            android:paddingBottom="16dp"
            android:gravity="center_vertical"
            android:baselineAligned="false"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_left_arrow"
                app:tint="#1E1E1E" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:fontFamily="@font/inter_bold"
                android:text="Detail Majalah"
                android:textColor="#1E1E1E"
                android:textSize="20sp" />
        </LinearLayout>

        <!-- 2. BACKGROUND GRADASI ORANYE -->
        <View
            android:id="@+id/bgGradient"
            android:layout_width="match_parent"
            android:layout_height="320dp"
            android:background="@drawable/bg_gradient_orange_detail"
            app:layout_constraintTop_toBottomOf="@id/headerLayout" />

        <!-- 3. SAMPUL MAJALAH UTAMA -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cvCover"
            android:layout_width="180dp"
            android:layout_height="250dp"
            android:layout_marginTop="24dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="12dp"
            app:layout_constraintTop_toBottomOf="@id/headerLayout"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:id="@+id/imgCover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/img_vol_07"
                android:scaleType="centerCrop" />
        </com.google.android.material.card.MaterialCardView>

        <!-- 4. INFO MAJALAH -->
        <TextView
            android:id="@+id/tvJudulMajalah"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="FRI VOL XXI/07 2026"
            android:textSize="20sp"
            android:textColor="#1E1E1E"
            android:fontFamily="@font/inter_bold"
            android:layout_marginTop="24dp"
            android:layout_marginHorizontal="24dp"
            app:layout_constraintTop_toBottomOf="@id/cvCover"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/tvHarga"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Rp 20.000"
            android:textSize="16sp"
            android:textColor="#27AE60"
            android:fontFamily="@font/inter_semibold"
            android:layout_marginTop="4dp"
            android:layout_marginHorizontal="24dp"
            app:layout_constraintTop_toBottomOf="@id/tvJudulMajalah"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- 5. CTA -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAction"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="16dp"
            android:text="Beli Sekarang"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:fontFamily="@font/inter_semibold"
            android:textAllCaps="false"
            app:backgroundTint="#00AA5B"
            app:cornerRadius="8dp"
            app:layout_constraintTop_toBottomOf="@id/tvHarga" />

        <!-- 6. PRATINJAU EDITORIAL -->
        <TextView
            android:id="@+id/tvPratinjauLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pratinjau Editorial"
            android:textSize="16sp"
            android:textColor="#1E1E1E"
            android:fontFamily="@font/inter_semibold"
            android:layout_marginTop="24dp"
            android:layout_marginStart="24dp"
            app:layout_constraintTop_toBottomOf="@id/btnAction"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Card Pratinjau -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cvPratinjauContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="#FFF0E6"
            app:cardCornerRadius="12dp"
            app:strokeWidth="1dp"
            app:strokeColor="#F0D0C0"
            app:cardElevation="0dp"
            app:layout_constraintTop_toBottomOf="@id/tvPratinjauLabel">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:gravity="center_horizontal">

                <!-- Gambar Pratinjau -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="256dp"
                    android:layout_height="351dp"
                    app:cardCornerRadius="4dp"
                    app:cardElevation="4dp">

                    <ImageView
                        android:id="@+id/imgPratinjau"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/img_vol_07"
                        android:scaleType="centerCrop" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Navigasi Halaman -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btnPanahKiri"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        app:cardBackgroundColor="#1E1E1E"
                        app:cardCornerRadius="8dp">
                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="10dp"
                            android:src="@drawable/ic_left_arrow"
                            app:tint="#FFFFFF"/>
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/tvHalamanPratinjau"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1 / 6"
                        android:textSize="14sp"
                        android:textColor="#1E1E1E"
                        android:fontFamily="@font/inter_semibold"
                        android:layout_marginHorizontal="24dp" />

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btnPanahKanan"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        app:cardBackgroundColor="#1E1E1E"
                        app:cardCornerRadius="8dp">
                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="10dp"
                            android:src="@drawable/ic_right_arrow"
                            app:tint="#FFFFFF"/>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>