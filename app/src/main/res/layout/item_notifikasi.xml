<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardNotif"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:strokeWidth="0dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/iconNotifBg"
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:cardBackgroundColor="#F4F6F8"
            app:cardCornerRadius="20dp"
            app:strokeWidth="0dp">
            <ImageView
                android:id="@+id/imgIconNotif"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_open_book" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="16dp"
            android:layout_toEndOf="@id/iconNotifBg"
            android:orientation="vertical">
            <TextView
                android:id="@+id/tvJudulNotif"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_bold"
                android:textColor="#1E1E1E"
                android:textSize="14sp" />
            <TextView
                android:id="@+id/tvPesanNotif"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/inter"
                android:textColor="#6B7280"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/tvWaktuNotif"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/inter"
                android:textColor="#9CA3AF"
                android:textSize="10sp" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/dotUnread"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="4dp"
            android:visibility="gone"
            app:cardBackgroundColor="#D32F2F"
            app:cardCornerRadius="4dp"
            app:strokeWidth="0dp" />
    </RelativeLayout>
</com.google.android.material.card.MaterialCardView>
