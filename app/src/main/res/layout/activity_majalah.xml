<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F8"
    android:fitsSystemWindows="true">

    <ScrollView
        android:id="@+id/mainScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:scrollbars="none"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNavLayout">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="32dp">

            <!-- HEADER -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:paddingHorizontal="24dp"
                android:paddingVertical="16dp">

                <ImageView
                    android:layout_width="120dp"
                    android:layout_height="30dp"
                    android:src="@drawable/logo_fri"
                    android:layout_centerVertical="true"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_search"
                        android:layout_marginEnd="12dp"/>

                    <ImageView
                        android:id="@+id/btnNotifikasi"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_bell"/>
                </LinearLayout>
            </RelativeLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Semua Majalah"
                android:textColor="#1E1E1E"
                android:textSize="20sp"
                android:fontFamily="@font/inter_bold"
                android:layout_marginTop="24dp"
                android:layout_marginHorizontal="24dp"/>

            <!-- CHIPS TAHUN -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:scrollbars="none"
                android:clipToPadding="false"
                android:paddingHorizontal="24dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Chip 2026  -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/chip2026"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="#D32F2F"
                        app:cardCornerRadius="16dp"
                        app:strokeWidth="0dp"
                        android:layout_marginEnd="8dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="2026"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="6dp"/>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Chip 2025  -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/chip2025"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="#FFFFFF"
                        app:cardCornerRadius="16dp"
                        app:strokeColor="#E5E7EB"
                        app:strokeWidth="1dp"
                        android:layout_marginEnd="8dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="2025"
                            android:textColor="#6B7280"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="6dp"/>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Chip 2024  -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/chip2024"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="#FFFFFF"
                        app:cardCornerRadius="16dp"
                        app:strokeColor="#E5E7EB"
                        app:strokeWidth="1dp"
                        android:layout_marginEnd="8dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="2024"
                            android:textColor="#6B7280"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="6dp"/>
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>
            </HorizontalScrollView>

            <!-- Kartu Banner -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="24dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/viewPagerHero"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    xmlns:tools="http://schemas.android.com/tools"
                    tools:listitem="@layout/hero_majalah" />

            </com.google.android.material.card.MaterialCardView>

            <!-- Indikator Slider -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/dot1"
                    android:layout_width="24dp"
                    android:layout_height="8dp"
                    app:cardCornerRadius="4dp"
                    app:cardBackgroundColor="#E53935"
                    app:cardElevation="0dp"
                    android:layout_marginEnd="6dp"/>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/dot2"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    app:cardCornerRadius="4dp"
                    app:cardBackgroundColor="#E0E0E0"
                    app:cardElevation="0dp"
                    android:layout_marginEnd="6dp"/>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/dot3"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    app:cardCornerRadius="4dp"
                    app:cardBackgroundColor="#E0E0E0"
                    app:cardElevation="0dp"/>
            </LinearLayout>

            <!-- SECTION 2026 -->
            <TextView
                android:id="@+id/section2026"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tahun 2026"
                android:textColor="#1E1E1E"
                android:textSize="16sp"
                android:fontFamily="@font/inter_bold"
                android:layout_marginTop="24dp"
                android:layout_marginHorizontal="24dp"/>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clipToPadding="false"
                android:paddingHorizontal="24dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- ITEM 1 -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="140dp"
                        android:layout_height="190dp"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="2dp"
                        android:layout_marginEnd="16dp">
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">
                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                android:src="@drawable/img_2026_vol_07" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="#00A859"
                                android:text="Rp20.000"
                                android:textColor="#FFFFFF"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="6dp"
                                android:layout_alignParentBottom="true"
                                android:layout_alignParentStart="true"
                                android:layout_margin="8dp"/>
                        </RelativeLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- ITEM 2 -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="140dp"
                        android:layout_height="190dp"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="2dp"
                        android:layout_marginEnd="16dp">
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">
                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                android:src="@drawable/img_2026_vol_06" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="#00A859"
                                android:text="Rp20.000"
                                android:textColor="#FFFFFF"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="6dp"
                                android:layout_alignParentBottom="true"
                                android:layout_alignParentStart="true"
                                android:layout_margin="8dp"/>
                        </RelativeLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- ITEM 3 -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="140dp"
                        android:layout_height="190dp"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="2dp"
                        android:layout_marginEnd="16dp">
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">
                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                android:src="@drawable/img_2026_vol_05" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="#00A859"
                                android:text="Rp20.000"
                                android:textColor="#FFFFFF"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="6dp"
                                android:layout_alignParentBottom="true"
                                android:layout_alignParentStart="true"
                                android:layout_margin="8dp"/>
                        </RelativeLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </HorizontalScrollView>

            <!-- SECTION 2025 -->
            <TextView
                android:id="@+id/section2025"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tahun 2025"
                android:textColor="#1E1E1E"
                android:textSize="16sp"
                android:fontFamily="@font/inter_bold"
                android:layout_marginTop="32dp"
                android:layout_marginHorizontal="24dp"/>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clipToPadding="false"
                android:paddingHorizontal="24dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- ITEM 1 (2025) -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="140dp"
                        android:layout_height="200dp"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="2dp"
                        android:layout_marginEnd="16dp">
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">
                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                android:src="@drawable/img_2025_vol_12" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="#00A859"
                                android:text="Rp20.000"
                                android:textColor="#FFFFFF"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="6dp"
                                android:layout_alignParentBottom="true"
                                android:layout_alignParentStart="true"
                                android:layout_margin="8dp"/>
                        </RelativeLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- ITEM 2 (2025) -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="140dp"
                        android:layout_height="200dp"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="2dp"
                        android:layout_marginEnd="16dp">
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">
                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                android:src="@drawable/img_2025_vol_11" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="#00A859"
                                android:text="Rp20.000"
                                android:textColor="#FFFFFF"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="6dp"
                                android:layout_alignParentBottom="true"
                                android:layout_alignParentStart="true"
                                android:layout_margin="8dp"/>
                        </RelativeLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- ITEM 2 (2025) -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="140dp"
                        android:layout_height="200dp"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="2dp"
                        android:layout_marginEnd="16dp">
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">
                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                android:src="@drawable/img_2025_vol_10" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="#00A859"
                                android:text="Rp20.000"
                                android:textColor="#FFFFFF"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="6dp"
                                android:layout_alignParentBottom="true"
                                android:layout_alignParentStart="true"
                                android:layout_margin="8dp"/>
                        </RelativeLayout>
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>
    </ScrollView>

    <!-- BOTTOM NAVIGATION (Disesuaikan khusus Halaman Majalah) -->
    <LinearLayout
        android:id="@+id/bottomNavLayout"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        app:layout_constraintBottom_toBottomOf="parent"
        android:background="#FFFFFF"
        android:orientation="horizontal"
        android:elevation="16dp"
        android:weightSum="4">

        <!-- MENU 1: BERANDA (STATE: TIDAK AKTIF) -->
        <RelativeLayout
            android:id="@+id/navBeranda"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <View
                android:layout_width="48dp"
                android:layout_height="6dp"
                android:layout_alignParentTop="true"
                android:layout_centerHorizontal="true"
                android:background="@drawable/bg_navbar_indicator"
                android:visibility="invisible" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_beranda"
                    app:tint="#A0A0A0"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Beranda"
                    android:textSize="12sp"
                    android:textColor="#A0A0A0"
                    android:fontFamily="@font/inter"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>
        </RelativeLayout>

        <!-- MENU 2: MAJALAH (STATE: AKTIF) -->
        <RelativeLayout
            android:id="@+id/navMajalah"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <!-- Indikator merah muncul -->
            <View
                android:layout_width="48dp"
                android:layout_height="6dp"
                android:layout_alignParentTop="true"
                android:layout_centerHorizontal="true"
                android:background="@drawable/bg_navbar_indicator" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_majalah_red"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Majalah"
                    android:textSize="12sp"
                    android:textColor="#D32F2F"
                    android:fontFamily="@font/inter_semibold"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>
        </RelativeLayout>

        <!-- MENU 3: KOLEKSI (STATE: TIDAK AKTIF) -->
        <RelativeLayout
            android:id="@+id/navKoleksi"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <View
                android:layout_width="48dp"
                android:layout_height="6dp"
                android:layout_alignParentTop="true"
                android:layout_centerHorizontal="true"
                android:background="@drawable/bg_navbar_indicator"
                android:visibility="invisible" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_koleksi"
                    app:tint="#A0A0A0"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Koleksi"
                    android:textSize="12sp"
                    android:textColor="#A0A0A0"
                    android:fontFamily="@font/inter"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>
        </RelativeLayout>

        <!-- MENU 4: AKUN (STATE: TIDAK AKTIF) -->
        <RelativeLayout
            android:id="@+id/navAkun"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <View
                android:layout_width="48dp"
                android:layout_height="6dp"
                android:layout_alignParentTop="true"
                android:layout_centerHorizontal="true"
                android:background="@drawable/bg_navbar_indicator"
                android:visibility="invisible" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:gravity="center"
                android:orientation="vertical">
                <!-- Icon dan font abu-abu -->
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_akun"
                    app:tint="#A0A0A0"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Akun"
                    android:textSize="12sp"
                    android:textColor="#A0A0A0"
                    android:fontFamily="@font/inter"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>
        </RelativeLayout>

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>