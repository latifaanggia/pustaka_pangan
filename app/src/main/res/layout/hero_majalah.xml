<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:layout_height="160dp">

        <!-- Background Foto Banner -->
        <ImageView
            android:id="@+id/imgBannerBgMajalah"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/img_2026_vol_07" />

        <!-- Gradient Overlay -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_gradient_overlay" />

        <!-- Tag TERBARU -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/tagTerbaru"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#D32F2F"
            app:cardCornerRadius="4dp"
            app:strokeWidth="0dp"
            android:layout_marginStart="20dp"
            android:layout_marginBottom="8dp"
            app:layout_constraintBottom_toTopOf="@id/tvJudulMajalahHero"
            app:layout_constraintStart_toStartOf="parent">

            <TextView
                android:id="@+id/tvTagHero"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TERBARU"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:fontFamily="@font/inter_semibold"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"/>
        </com.google.android.material.card.MaterialCardView>

        <!-- Judul Majalah -->
        <TextView
            android:id="@+id/tvJudulMajalahHero"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="FRI VOL XXI/07 2026"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:fontFamily="@font/inter_bold"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="12dp"
            android:shadowColor="#99000000"
            android:shadowDx="1"
            android:shadowDy="2"
            android:shadowRadius="4"
            app:layout_constraintBottom_toTopOf="@id/btnBeliMajalahHero"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Tombol Beli -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBeliMajalahHero"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="Beli - Rp 20.000"
            android:textColor="#1E1E1E"
            android:textSize="14sp"
            android:fontFamily="@font/inter_bold"
            android:textAllCaps="false"
            app:backgroundTint="#FFFFFF"
            app:cornerRadius="8dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:layout_marginStart="20dp"
            android:layout_marginBottom="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
