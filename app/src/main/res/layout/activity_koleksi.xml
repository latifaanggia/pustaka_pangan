                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:layout_marginStart="8dp"
                                app:cardBackgroundColor="#FFFFFF"
                                app:strokeColor="#E5E7EB"
                                app:strokeWidth="1dp"
                                app:cardCornerRadius="6dp"
