                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Majalah"
                    android:textSize="12sp"
                    android:textColor="#A0A0A0"
                    android:fontFamily="@font/inter"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>
        </RelativeLayout>

        <!-- MENU 3: KOLEKSI (STATE: AKTIF MERAH) -->
        <RelativeLayout
            android:id="@+id/navKoleksi"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <View
                android:layout_width="48dp"
                android:layout_height="6dp"
                android:layout_alignParentTop="true"
                android:layout_centerHorizontal="true"
                android:background="@drawable/bg_navbar_indicator" />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_koleksi"
                    app:tint="#D32F2F"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Koleksi"
                    android:textSize="12sp"
                    android:textColor="#D32F2F"
                    android:fontFamily="@font/inter_semibold"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>
        </RelativeLayout>

        <!-- MENU 4: AKUN (STATE: TIDAK AKTIF) -->
        <RelativeLayout
            android:id="@+id/navAkun"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <View
                android:layout_width="48dp"
                android:layout_height="6dp"
                android:layout_alignParentTop="true"
                android:layout_centerHorizontal="true"
                android:background="@drawable/bg_navbar_indicator"
                android:visibility="invisible" />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_akun"
                    app:tint="#A0A0A0"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Akun"
                    android:textSize="12sp"
                    android:textColor="#A0A0A0"
                    android:fontFamily="@font/inter"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>
        </RelativeLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>