<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F8"
    android:fitsSystemWindows="true">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:scrollbars="none"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNavLayout">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="32dp">

            <!-- HEADER -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:paddingHorizontal="24dp"
                android:paddingVertical="16dp">

                <ImageView
                    android:layout_width="120dp"
                    android:layout_height="30dp"
                    android:src="@drawable/logo_fri"
                    android:layout_centerVertical="true"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_search"
                        android:layout_marginEnd="12dp"/>

                    <FrameLayout
                        android:layout_width="32dp"
                        android:layout_height="32dp">
                        <ImageView
                            android:id="@+id/btnNotifikasi"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/ic_bell_default"/>
                        <View
                            android:id="@+id/dotNotifBell"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:layout_gravity="top|end"
                            android:layout_marginTop="3dp"
                            android:layout_marginEnd="3dp"
                            android:background="@drawable/bg_badge_dot" />
                    </FrameLayout>
                </LinearLayout>
            </RelativeLayout>

            <!-- SECTION: TERAKHIR DIBACA (muncul kalau ada majalah yang pernah dibuka) -->
            <TextView
                android:id="@+id/tvLabelTerakhirDibaca"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Terakhir Dibaca"
                android:textColor="#1E1E1E"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="24dp"
                android:layout_marginHorizontal="24dp"/>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardTerakhirDibaca"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF"
                app:strokeColor="#E5E7EB"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical">

                    <!-- Cover Majalah Mini -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="60dp"
                        android:layout_height="80dp"
                        app:cardCornerRadius="6dp"
                        app:cardElevation="0dp">
                        <ImageView
                            android:id="@+id/imgCoverTerakhir"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:background="#E5E7EB" />
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Judul & Tombol Lanjut Baca -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp">

                        <TextView
                            android:id="@+id/tvJudulTerakhir"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="FRI VOL XXI/04 2026"
                            android:textColor="#1E1E1E"
                            android:textSize="18sp"
                            android:textStyle="bold"/>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="8dp">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_play_green"/>

                            <TextView
                                android:id="@+id/tvLanjutTerakhir"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Lanjutkan Membaca"
                                android:textColor="#00A859"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:layout_marginStart="4dp"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- SECTION PER TAHUN: diisi dari KoleksiActivity (item_koleksi_tahun.xml + item_koleksi_majalah.xml) -->
            <LinearLayout
                android:id="@+id/layoutKoleksiTahun"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <ProgressBar
                android:id="@+id/progressKoleksi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="64dp"
                android:indeterminateTint="#00A859" />

            <!-- EMPTY STATE / GAGAL MEMUAT -->
            <LinearLayout
                android:id="@+id/layoutKoleksiKosong"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="32dp"
                android:layout_marginTop="64dp"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:visibility="gone">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_open_book" />

                <TextView
                    android:id="@+id/tvKoleksiKosong"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:text="Koleksimu masih kosong.\nBeli majalah untuk mulai membaca."
                    android:textColor="#6B7280"
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAksiKoleksiKosong"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:backgroundTint="#00A859"
                    android:text="Jelajahi Majalah"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    app:cornerRadius="8dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- CUSTOM BOTTOM NAVIGATION -->
    <LinearLayout
        android:id="@+id/bottomNavLayout"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        app:layout_constraintBottom_toBottomOf="parent"
        android:background="#FFFFFF"
        android:orientation="horizontal"
        android:elevation="16dp"
        android:weightSum="4">

        <!-- MENU 1: BERANDA (STATE: TIDAK AKTIF) -->
        <RelativeLayout
            android:id="@+id/navBeranda"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <View
                android:layout_width="48dp"
                android:layout_height="6dp"
                android:layout_alignParentTop="true"
                android:layout_centerHorizontal="true"
                android:background="@drawable/bg_navbar_indicator"
                android:visibility="invisible" />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_beranda"
                    app:tint="#A0A0A0"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Beranda"
                    android:textSize="12sp"
                    android:textColor="#A0A0A0"
                    android:fontFamily="@font/inter"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>
        </RelativeLayout>

        <!-- MENU 2: MAJALAH (STATE: TIDAK AKTIF) -->
        <RelativeLayout
            android:id="@+id/navMajalah"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <View
                android:layout_width="48dp"
                android:layout_height="6dp"
                android:layout_alignParentTop="true"
                android:layout_centerHorizontal="true"
                android:background="@drawable/bg_navbar_indicator"
                android:visibility="invisible" />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_majalah"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Majalah"
                    android:textSize="12sp"
                    android:textColor="#A0A0A0"
                    android:fontFamily="@font/inter"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>
        </RelativeLayout>

        <!-- MENU 3: KOLEKSI (STATE: AKTIF MERAH) -->
        <RelativeLayout
            android:id="@+id/navKoleksi"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <View
                android:layout_width="48dp"
                android:layout_height="6dp"
                android:layout_alignParentTop="true"
                android:layout_centerHorizontal="true"
                android:background="@drawable/bg_navbar_indicator" />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_koleksi"
                    app:tint="#D32F2F"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Koleksi"
                    android:textSize="12sp"
                    android:textColor="#D32F2F"
                    android:fontFamily="@font/inter_semibold"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>
        </RelativeLayout>

        <!-- MENU 4: AKUN (STATE: TIDAK AKTIF) -->
        <RelativeLayout
            android:id="@+id/navAkun"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <View
                android:layout_width="48dp"
                android:layout_height="6dp"
                android:layout_alignParentTop="true"
                android:layout_centerHorizontal="true"
                android:background="@drawable/bg_navbar_indicator"
                android:visibility="invisible" />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_akun"
                    app:tint="#A0A0A0"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Akun"
                    android:textSize="12sp"
                    android:textColor="#A0A0A0"
                    android:fontFamily="@font/inter"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>
        </RelativeLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>