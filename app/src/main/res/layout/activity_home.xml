<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F8">

    <!-- 1. HEADER -->
    <RelativeLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:layout_alignParentTop="true"
        android:background="#FFFFFF"
        android:paddingHorizontal="24dp"
        android:elevation="4dp">

        <ImageView
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:src="@drawable/logo_fri" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:src="@drawable/ic_search"
                android:layout_marginEnd="12dp"/>

            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:src="@drawable/ic_bell" />
        </LinearLayout>
    </RelativeLayout>

    <!-- 2. BOTTOM NAVIGATION -->
    <LinearLayout
        android:id="@+id/bottomNavLayout"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_alignParentBottom="true"
        android:background="#FFFFFF"
        android:orientation="horizontal"
        android:elevation="16dp"
        android:weightSum="4">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_bell"
                app:tint="#D32F2F"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Beranda"
                android:textSize="10sp"
                android:textColor="#D32F2F"
                android:fontFamily="@font/inter_semibold"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

        <!-- Tambahkan ikon lainnya (Majalah, Koleksi, Akun) di sini sesuai kebutuhan -->

    </LinearLayout>

    <!-- 3. AREA TENGAH (SCROLLABLE) -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/headerLayout"
        android:layout_above="@id/bottomNavLayout"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="16dp"
            android:paddingBottom="24dp">

            <!-- ========================================= -->
            <!-- SECTION: HERO BANNER PROMO                -->
            <!-- ========================================= -->

            <!-- Kartu Banner (Sekarang isinya ViewPager2) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:layout_marginHorizontal="24dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <!-- Ini dia Mesin Proyektor-nya -->
                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/viewPagerHero"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

            </com.google.android.material.card.MaterialCardView>

            <!-- Titik-Titik Indikator Slider (Sudah Dikasih ID dot1, dot2, dot3) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/dot1"
                    android:layout_width="24dp"
                    android:layout_height="8dp"
                    app:cardCornerRadius="4dp"
                    app:cardBackgroundColor="#E53935"
                    app:cardElevation="0dp"
                    android:layout_marginEnd="6dp"/>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/dot2"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    app:cardCornerRadius="4dp"
                    app:cardBackgroundColor="#E0E0E0"
                    app:cardElevation="0dp"
                    android:layout_marginEnd="6dp"/>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/dot3"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    app:cardCornerRadius="4dp"
                    app:cardBackgroundColor="#E0E0E0"
                    app:cardElevation="0dp"/>
            </LinearLayout>


            <!-- ========================================= -->
            <!-- SECTION: HEADER TERBARU & LIHAT SEMUA     -->
            <!-- ========================================= -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="12dp">

                <!-- Teks Kiri -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Terbaru"
                    android:textSize="16sp"
                    android:textColor="#1E1E1E"
                    android:fontFamily="@font/inter_semibold"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true" />

                <!-- Teks Kanan (Bisa diklik nanti) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lihat Semua"
                    android:textSize="12sp"
                    android:textColor="#00AA5B"
                    android:fontFamily="@font/inter_semibold"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true" />
            </RelativeLayout>

            <!-- ========================================= -->
            <!-- SECTION: SLIDER MAJALAH TERBARU           -->
            <!-- ========================================= -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:clipToPadding="false"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingBottom="16dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- ITEM MAJALAH TERBARU 1 -->
                    <!-- Dibungkus LinearLayout vertikal agar teks bisa di bawah gambar -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginEnd="16dp">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="148dp"
                            android:layout_height="203dp"
                            app:cardCornerRadius="8dp"
                            app:strokeWidth="1dp"
                            app:strokeColor="#DFDFDF"
                            app:cardElevation="4dp"
                            android:outlineAmbientShadowColor="#14000000"
                            android:outlineSpotShadowColor="#14000000">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:src="@drawable/img_vol_07"
                                android:scaleType="centerCrop" />
                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="FRI VOL XXI/07 2026"
                            android:textSize="12sp"
                            android:textColor="#1E1E1E"
                            android:fontFamily="@font/inter_semibold"
                            android:layout_marginTop="12dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Rp20.000"
                            android:textSize="12sp"
                            android:textColor="#888888"
                            android:fontFamily="@font/inter"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>

                    <!-- ITEM MAJALAH TERBARU 2 -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginEnd="16dp">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="148dp"
                            android:layout_height="203dp"
                            app:cardCornerRadius="8dp"
                            app:strokeWidth="1dp"
                            app:strokeColor="#DFDFDF"
                            app:cardElevation="4dp"
                            android:outlineAmbientShadowColor="#14000000"
                            android:outlineSpotShadowColor="#14000000">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:src="@drawable/img_vol_06"
                                android:scaleType="centerCrop" />
                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="FRI VOL XXI/06 2026"
                            android:textSize="12sp"
                            android:textColor="#1E1E1E"
                            android:fontFamily="@font/inter_semibold"
                            android:layout_marginTop="12dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Rp20.000"
                            android:textSize="12sp"
                            android:textColor="#888888"
                            android:fontFamily="@font/inter"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>

                </LinearLayout>
            </HorizontalScrollView>

            <!-- ========================================= -->
            <!-- SECTION: POPULER                          -->
            <!-- ========================================= -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Populer"
                android:textSize="16sp"
                android:textColor="#1E1E1E"
                android:fontFamily="@font/inter_semibold"
                android:layout_marginStart="24dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="12dp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:clipToPadding="false"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingBottom="16dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Sampul Populer 1 (Tanpa Teks Bawah) -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="140dp"
                        android:layout_height="190dp"
                        android:layout_marginEnd="16dp"
                        app:cardCornerRadius="8dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="#DFDFDF"
                        app:cardElevation="4dp"
                        android:outlineAmbientShadowColor="#14000000"
                        android:outlineSpotShadowColor="#14000000">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/img_vol_07"
                            android:scaleType="centerCrop" />
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Sampul Populer 2 -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="140dp"
                        android:layout_height="190dp"
                        android:layout_marginEnd="16dp"
                        app:cardCornerRadius="8dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="#DFDFDF"
                        app:cardElevation="4dp"
                        android:outlineAmbientShadowColor="#14000000"
                        android:outlineSpotShadowColor="#14000000">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/img_vol_06"
                            android:scaleType="centerCrop" />
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Sampul Populer 3 -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="140dp"
                        android:layout_height="190dp"
                        android:layout_marginEnd="16dp"
                        app:cardCornerRadius="8dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="#DFDFDF"
                        app:cardElevation="4dp"
                        android:outlineAmbientShadowColor="#14000000"
                        android:outlineSpotShadowColor="#14000000">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/img_vol_05"
                            android:scaleType="centerCrop" />
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </HorizontalScrollView>

            <!-- ========================================= -->
            <!-- SECTION: GRATIS                           -->
            <!-- ========================================= -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gratis"
                android:textSize="16sp"
                android:textColor="#1E1E1E"
                android:fontFamily="@font/inter_semibold"
                android:layout_marginStart="24dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="12dp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:clipToPadding="false"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingBottom="24dp"> <!-- Padding bawah dilebihkan sedikit untuk akhir scroll -->

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Sampul Gratis 1 (Dengan Label FREE) -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="140dp"
                        android:layout_height="190dp"
                        android:layout_marginEnd="16dp"
                        app:cardCornerRadius="8dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="#DFDFDF"
                        app:cardElevation="4dp"
                        android:outlineAmbientShadowColor="#14000000"
                        android:outlineSpotShadowColor="#14000000">

                        <!-- FrameLayout agar tulisan FREE bisa menumpuk di atas gambar -->
                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:src="@drawable/img_free_1"
                                android:scaleType="centerCrop" />

                            <!-- Label FREE -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="FREE"
                                android:textColor="#FFFFFF"
                                android:textSize="10sp"
                                android:fontFamily="@font/inter_semibold"
                                android:background="#00AA5B"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="4dp" />
                        </FrameLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <!-- Sampul Gratis 2 (Dengan Label FREE) -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="140dp"
                        android:layout_height="190dp"
                        android:layout_marginEnd="16dp"
                        app:cardCornerRadius="8dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="#DFDFDF"
                        app:cardElevation="4dp"
                        android:outlineAmbientShadowColor="#14000000"
                        android:outlineSpotShadowColor="#14000000">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:src="@drawable/img_free_2"
                                android:scaleType="centerCrop" />

                            <!-- Label FREE -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="FREE"
                                android:textColor="#FFFFFF"
                                android:textSize="10sp"
                                android:fontFamily="@font/inter_semibold"
                                android:background="#00AA5B"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="4dp" />
                        </FrameLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <!-- Sampul Gratis 3 (Dengan Label FREE) -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="140dp"
                        android:layout_height="190dp"
                        android:layout_marginEnd="16dp"
                        app:cardCornerRadius="8dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="#DFDFDF"
                        app:cardElevation="4dp"
                        android:outlineAmbientShadowColor="#14000000"
                        android:outlineSpotShadowColor="#14000000">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:src="@drawable/img_free_3"
                                android:scaleType="centerCrop" />

                            <!-- Label FREE -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="FREE"
                                android:textColor="#FFFFFF"
                                android:textSize="10sp"
                                android:fontFamily="@font/inter_semibold"
                                android:background="#00AA5B"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="4dp" />
                        </FrameLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <!-- Sampul Gratis 4 (Dengan Label FREE) -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="140dp"
                        android:layout_height="190dp"
                        android:layout_marginEnd="16dp"
                        app:cardCornerRadius="8dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="#DFDFDF"
                        app:cardElevation="4dp"
                        android:outlineAmbientShadowColor="#14000000"
                        android:outlineSpotShadowColor="#14000000">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:src="@drawable/img_free_4"
                                android:scaleType="centerCrop" />

                            <!-- Label FREE -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="FREE"
                                android:textColor="#FFFFFF"
                                android:textSize="10sp"
                                android:fontFamily="@font/inter_semibold"
                                android:background="#00AA5B"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="4dp" />
                        </FrameLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <!-- Sampul Gratis 5 (Dengan Label FREE) -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="140dp"
                        android:layout_height="190dp"
                        android:layout_marginEnd="16dp"
                        app:cardCornerRadius="8dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="#DFDFDF"
                        app:cardElevation="4dp"
                        android:outlineAmbientShadowColor="#14000000"
                        android:outlineSpotShadowColor="#14000000">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:src="@drawable/img_free_5"
                                android:scaleType="centerCrop" />

                            <!-- Label FREE -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="FREE"
                                android:textColor="#FFFFFF"
                                android:textSize="10sp"
                                android:fontFamily="@font/inter_semibold"
                                android:background="#00AA5B"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="4dp" />
                        </FrameLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <!-- Sampul Gratis 6 (Dengan Label FREE) -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="140dp"
                        android:layout_height="190dp"
                        android:layout_marginEnd="16dp"
                        app:cardCornerRadius="8dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="#DFDFDF"
                        app:cardElevation="4dp"
                        android:outlineAmbientShadowColor="#14000000"
                        android:outlineSpotShadowColor="#14000000">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:src="@drawable/img_free_6"
                                android:scaleType="centerCrop" />

                            <!-- Label FREE -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="FREE"
                                android:textColor="#FFFFFF"
                                android:textSize="10sp"
                                android:fontFamily="@font/inter_semibold"
                                android:background="#00AA5B"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="4dp" />
                        </FrameLayout>

                    </com.google.android.material.card.MaterialCardView>


                </LinearLayout>
            </HorizontalScrollView>

        </LinearLayout>
    </ScrollView>

</RelativeLayout>